{
  "name": "itmosoft/laravel-forms",
  "description": "Dynamic form definitions, versioned fields, submissions, and validation for Laravel applications.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/validation": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "ItmoSoft\\Forms\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ItmoSoft\\Forms\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ItmoSoft\\Forms\\FormsServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "php -l src/FormsServiceProvider.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
